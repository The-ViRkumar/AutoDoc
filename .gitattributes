# AutoDoc: .editorconfig and Biome (`lineEnding: lf`) require LF everywhere, but the
# rules below only cover some extensions. On Windows (core.autocrlf=true) every other
# text file (.json, .jsonc, .js, .cjs ...) was checked out as CRLF and failed the
# pre-commit Biome check. This catch-all comes FIRST so the more specific rules below
# (e.g. `workbench/measurements/** -text`) still win.
* text=auto eol=lf

# The compositor is developed across Windows, macOS and Linux. Without this, a
# checkout on Windows can reintroduce CRLF and the shader sources drift from the
# `end_of_line = lf` / `charset = utf-8` that .editorconfig already mandates —
# which is how blur.wgsl, layer.wgsl and linux_decode.rs ended up with CRLF and
# double-encoded French comments in the first place.
*.wgsl text eol=lf
*.rs   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
# Vite's SSR hashbang detection requires LF in imported executable modules.
*.mjs  text eol=lf
# Same drift, caught on the native helper's build file: an edit from Windows
# rewrote all 67 lines as CRLF and buried a 22-line change in a 156-line diff.
CMakeLists.txt text eol=lf
# And on the website's translations: pages written on Windows landed as CRLF,
# so the next one-line edit showed up as a whole-file rewrite in two locales.
*.md   text eol=lf
*.mdx  text eol=lf

# Adopted measurement manifests hash exact bytes; keep their artifacts unchanged.
workbench/measurements/** -text
